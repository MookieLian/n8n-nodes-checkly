{
	"name": "@mookielianhd/n8n-nodes-checkly",
	"version": "0.1.0",
	"description": "n8n community node for the Checkly API - manage checks, check groups, alert channels, dashboards, maintenance windows and more, plus a webhook trigger for alerts",
	"license": "MIT",
	"homepage": "https://github.com/MookieLian/n8n-nodes-checkly#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"checkly",
		"monitoring",
		"synthetic-monitoring"
	],
	"author": {
		"name": "mookielianhd",
		"email": "mookielianhd@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MookieLian/n8n-nodes-checkly.git"
	},
	"bugs": {
		"url": "https://github.com/MookieLian/n8n-nodes-checkly/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ChecklyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Checkly/Checkly.node.js",
			"dist/nodes/Checkly/ChecklyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
